{
  "name": "trot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview",
    "start": "node server/index.js",
    "test": "node --test server/",
    "test:native": "node --test src/native/native.test.js",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:build": "npm run ios:sync && cap open ios",
    "ios:assets": "npx --yes @capacitor/assets@4 generate --ios"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.2",
    "@capacitor/core": "^8.6.3",
    "@capacitor/ios": "^8.6.3",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capgo/capacitor-nfc": "^8.3.11",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.4.0",
    "vite-plugin-singlefile": "^2.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
